# Development-only files, left out of GitHub's release archives (what GPM installs)
# and of `git archive`. docs/setup/ stays: the settings page reads it at runtime.
.github         export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.yamllint       export-ignore
phpstan.neon    export-ignore
tests           export-ignore
CLAUDE.md       export-ignore
PLAN.md         export-ignore
docs/agents     export-ignore
